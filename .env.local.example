# 이 파일은 "양식"입니다. 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우세요.
#   (Windows)  copy .env.local.example .env.local
#   (macOS/Linux)  cp .env.local.example .env.local
# 실제 키는 .env.local 에만 넣고, 절대 커밋하거나 이 파일에 적지 마세요.
# 값에는 따옴표·공백을 넣지 않습니다. 공공데이터포털 키는 "Decoding" 키를 넣으세요.
#
# Vercel 배포 시에는 이 파일이 아니라 Project Settings > Environment Variables 에 같은 이름으로 등록합니다.

# ── 서버 전용 (NEXT_PUBLIC_ 접두사 없음 → 브라우저로 전달되지 않음) ──
# 서울 열린데이터광장 인증키 (https://data.seoul.go.kr) — 따릉이 실시간 대여정보(bikeList)
SEOUL_API_KEY=
# 공공데이터포털 일반 인증키 (https://www.data.go.kr)
#   활용신청 필요: 기상청_단기예보 조회서비스, 도로교통공단_자전거 교통사고 다발지역
DATA_GO_KR_API_KEY=
# Kakao Developers > 앱 키 > REST API 키 — 장소 검색(로컬 API) + 자전거 경로
KAKAO_REST_API_KEY=

# ── 브라우저 공개용 (빌드 시점에 번들에 포함됨. 값을 바꾸면 재배포 필요) ──
# Kakao Developers > 앱 키 > JavaScript 키.
# 키 자체는 공개되므로, 허용 도메인 등록(플랫폼 > Web)으로 보호합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
